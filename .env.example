# Copy to .env and fill in.

# Postgres password (used by db, app and backup services)
DB_PASSWORD=change-me

# Cloudflare Tunnel token — only needed with `docker compose --profile tunnel up`.
# Zero Trust dashboard → Networks → Tunnels → Create → copy the token.
# Point the tunnel's public hostname to http://app:3000
TUNNEL_TOKEN=

# Backups: how many dumps to keep, and seconds between dumps
BACKUP_KEEP=7
BACKUP_INTERVAL=86400

# Local dev (npm run dev) outside Docker
DATABASE_URL=postgres://converse:change-me@localhost:5432/converse
